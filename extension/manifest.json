{
  "manifest_version": 3,
  "name": "Job Hunt Agent Autofill",
  "version": "1.2.1",
  "description": "Fills job applications with your tailored resume and saved answers from Job Hunt Agent. Never clicks Next or Submit.",
  "key": "",
  "minimum_chrome_version": "111",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*", "http://*.ts.net/*", "https://*.ts.net/*", "http://*.local/*"],
  "background": {"service_worker": "background.js"},
  "options_page": "options.html",
  "action": {"default_title": "Job Hunt Agent Autofill: show the panel", "default_icon": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"}},
  "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"},
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "all_frames": true,
      "run_at": "document_idle",
      "js": ["content/core.js", "content/guard.js", "content/pick.js", "content/fields.js", "content/fill.js", "content/learn.js", "content/experience.js",
             "content/boards/workday.js", "content/boards/greenhouse.js", "content/boards/lever.js",
             "content/boards/ashby.js", "content/boards/smartrecruiters.js", "content/boards/icims.js",
             "content/boards/bamboohr.js", "content/boards/rippling.js", "content/boards/jobvite.js",
             "content/boards/taleo.js", "content/boards/successfactors.js", "content/boards/oracle.js",
             "content/boards/paylocity.js", "content/boards/adp.js", "content/boards/dayforce.js",
             "content/boards/jazzhr.js", "content/boards/breezy.js", "content/boards/workable.js",
             "content/boards/gem.js", "content/boards/generic.js",
             "content/panel.js", "content/main.js", "content/queue.js"]
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "all_frames": true,
      "run_at": "document_idle",
      "world": "MAIN",
      "js": ["page/bridge.js"]
    }
  ]
}
